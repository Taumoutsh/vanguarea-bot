# ===== Obligatoire =====
# Token fourni par @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat(s) autorisé(s) à utiliser le bot et à recevoir les alertes (séparés par des virgules).
# Astuce : envoyez /start au bot, il vous répond avec votre chat ID.
TELEGRAM_CHAT_IDS=123456789

# ===== Général =====
TZ=Europe/Paris
# Nom affiché dans les alertes (par défaut : hostname)
SERVER_NAME=
# Vérifications système + Docker (secondes)
CHECK_INTERVAL=300
# Vérifications sécurité : SSH, réseau, logs web, fichiers sensibles (secondes)
SECURITY_INTERVAL=60
# Délai minimal avant de répéter une même alerte (secondes)
ALERT_COOLDOWN=3600
DAILY_REPORT_TIME=08:00

# ===== Seuils OS (%) =====
CPU_THRESHOLD=90
MEM_THRESHOLD=90
SWAP_THRESHOLD=80
DISK_THRESHOLD=85
INODE_THRESHOLD=85
# Charge moyenne 5 min divisée par le nombre de CPU
LOAD_THRESHOLD=2.0

# ===== Docker =====
# Conteneurs à ignorer (séparés par des virgules)
DOCKER_IGNORE=

# ===== CVE (Trivy) =====
# CRITICAL ou CRITICAL,HIGH
CVE_SEVERITIES=CRITICAL
# true = uniquement les CVE pour lesquelles un correctif existe
CVE_IGNORE_UNFIXED=true
CVE_SCAN_HOST=true
CVE_SCAN_IMAGES=true
# Scans silencieux toutes les N heures. Le rapport quotidien montre les CVE apparues
# ou corrigées depuis le rapport précédent ; seules les failles activement exploitées
# (catalogue CISA KEV) déclenchent une alerte immédiate.
CVE_SCAN_INTERVAL=6
# Arrêter automatiquement les conteneurs dont l'image contient une CVE activement
# exploitée (uniquement ceux-là, pas toutes les CVE critiques). Un conteneur relancé
# à la main n'est pas ré-arrêté pour les mêmes CVE.
AUTO_STOP_EXPLOITED=false
# Conteneurs, services ou projets compose à ne jamais arrêter (ex. reverse proxy)
AUTO_STOP_EXCLUDE=vanguarea-bot

# ===== Détection d'attaques =====
# Échecs SSH par IP et par intervalle avant alerte
SSH_FAIL_THRESHOLD=15
# IP de confiance (pas d'alerte de connexion / brute force)
SSH_TRUSTED_IPS=
# Infos sur l'IP des connexions SSH : ipinfo (pays, ville, opérateur — 50 000 requêtes/mois
# gratuites, IP mises en cache 30 jours), rdap (pays + opérateur, sans ville ni limite) ou none
GEOIP_PROVIDER=ipinfo
# Facultatif : jeton ipinfo.io gratuit pour relever les limites
IPINFO_TOKEN=
# Connexions semi-ouvertes (SYN flood)
SYN_RECV_THRESHOLD=200
# Connexions établies simultanées depuis une même IP publique
CONN_PER_IP_THRESHOLD=150
# Trafic entrant par interface (DDoS volumétrique)
RX_PPS_THRESHOLD=50000
RX_MBPS_THRESHOLD=500
# Logs d'accès HTTP à analyser (chemins sur l'hôte, séparés par des virgules)
# ex : /var/log/nginx/access.log,/opt/traefik/logs/access.log
ACCESS_LOGS=
# Requêtes par IP et par intervalle avant alerte « flood HTTP »
HTTP_RATE_THRESHOLD=600
# Score de requêtes suspectes par IP avant alerte « scan »
HTTP_SCAN_THRESHOLD=20
# Fichiers / dossiers surveillés (laisser vide pour la liste par défaut)
WATCHED_FILES=
